PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
AI_PORT=8001
NODE_ENV=development

# Railway MySQL public connection string
# Use the public host/port from your Railway MySQL service.
# Example:
# DATABASE_URL=mysql://root:your_password@sakura.proxy.rlwy.net:25938/railway
DATABASE_URL=mysql://root:your_password@your-public-host:3306/railway

# Optional Gemini integration for the AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
