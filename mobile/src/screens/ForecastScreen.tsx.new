/**
 * screens/ForecastScreen.tsx
 * Real 24-hour and 7-day forecast from the backend weather API.
 */

import React from 'react';
import { StyleSheet, Text, View } from 'react-native';
import { ScreenContainer } from '../components/ScreenContainer';
import { SectionHeader } from '../components/SectionHeader';
import { EmptyView, ErrorView } from '../components/StateViews';
import { LoadingPlaceholder } from '../components/LoadingPlaceholder';
import { Card } from '../components/ui/Card';
import { Badge } from '../components/ui/Badge';
import { conditionIcon } from '../components/ui/IconMapper';
import { COLORS, SPACING, TYPOGRAPHY, BORDER_RADIUS } from '../constants/theme';
import { useLocation, useForecast } from '../hooks';

export function ForecastScreen() {
  const location = useLocation();
  const forecast = useForecast(location.data?.latitude ?? null, location.data?.longitude ?? null);

  if (location.isLoading && !location.data) {
    return (
      <ScreenContainer>
        <LoadingPlaceholder message="Finding your location..." />
      </ScreenContainer>
    );
  }
  if (location.error) {
    return (
      <ScreenContainer>
        <ErrorView message={location.error} onRetry={location.refresh} />
      </ScreenContainer>
    );
  }

  if (forecast.isLoading && !forecast.data) {
    return (
      <ScreenContainer>
        <LoadingPlaceholder message="Loading forecast..." />
      </ScreenContainer>
    );
  }
  if (forecast.error) {
    return (
      <ScreenContainer>
        <ErrorView message={forecast.error} onRetry={forecast.refresh} />
      </ScreenContainer>
    );
  }

  const hourly = forecast.data?.hourly ?? [];
  const daily = forecast.data?.daily ?? [];

  return (
    <ScreenContainer scrollable>
      <SectionHeader title="Next 24 Hours" />
      {hourly.length === 0 ? (
        <EmptyView message="No hourly data available." />
      ) : (
        <View>
          {hourly.map((h) => {
            const dt = new Date(h.time);
            const label = dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            return (
              <Card key={h.time} style={styles.hourCard}>
                <Text style={styles.hourTime}>{label}</Text>
                <Text style={styles.hourIcon}>{conditionIcon(h.condition)}</Text>
                <Text style={styles.hourTemp}>{h.temperatureC}°</Text>
                <View style={styles.hourRain}>
                  <Badge label={`🌧 ${h.rainProbability}%`} tone={h.rainProbability >= 50 ? 'warning' : 'info'} />
                </View>
              </Card>
            );
          })}
        </View>
      )}

      <SectionHeader title="7-Day Forecast" />
      {daily.length === 0 ? (
        <EmptyView message="No daily data available." />
      ) : (
        <View>
          {daily.map((d) => {
            const dt = new Date(d.date);
            const label = dt.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
            return (
              <Card key={d.date} style={styles.dayCard}>
                <Text style={styles.dayDate}>{label}</Text>
                <Text style={styles.dayIcon}>{conditionIcon(d.condition)}</Text>
                <View style={styles.dayTemps}>
                  <Text style={styles.dayMax}>{d.maxTempC}°</Text>
                  <Text style={styles.dayMin}>{d.minTempC}°</Text>
                </View>
                <Badge
                  label={`UV ${d.uvIndex}`}
                  tone={d.uvIndex >= 8 ? 'danger' : d.uvIndex >= 6 ? 'warning' : 'info'}
                />
              </Card>
            );
          })}
        </View>
      )}
    </ScreenContainer>
  );
}

const styles = StyleSheet.create({
  hourCard: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: SPACING.m,
  },
  hourTime: { width: 56, color: COLORS.textSecondary, fontSize: TYPOGRAPHY.fontSize.m },
  hourIcon: { fontSize: 22 },
  hourTemp: {
    flex: 1,
    color: COLORS.textPrimary,
    fontSize: TYPOGRAPHY.fontSize.l,
    fontWeight: TYPOGRAPHY.fontWeight.bold,
  },
  hourRain: { alignItems: 'flex-end' },
  dayCard: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: SPACING.m,
  },
  dayDate: {
    flex: 1,
    color: COLORS.textPrimary,
    fontSize: TYPOGRAPHY.fontSize.m,
    fontWeight: TYPOGRAPHY.fontWeight.medium,
  },
  dayIcon: { fontSize: 22 },
  dayTemps: {
    flexDirection: 'row',
    gap: SPACING.s,
    alignItems: 'center',
  },
  dayMax: {
    color: COLORS.textPrimary,
    fontSize: TYPOGRAPHY.fontSize.m,
    fontWeight: TYPOGRAPHY.fontWeight.bold,
    width: 34,
    textAlign: 'right',
  },
  dayMin: { color: COLORS.textSecondary, fontSize: TYPOGRAPHY.fontSize.m, width: 34, textAlign: 'right' },
});
